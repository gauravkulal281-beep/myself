      "parameters": {
        "jsCode": "const raw=$json.candidates?.[0]?.content?.parts?.map(p=>p.text||'').join('');const data=JSON.parse(raw);if(!data||typeof data!=='object')throw Error('Unexpected response');return [{json:data}];"
