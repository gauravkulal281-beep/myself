        "jsCode": "const b=$json.body||{};const text=(v,n)=>typeof v==='string'&&v.trim().length>0&&v.length<=n;if(!(text(b.text,4000)&&['Adam','Rachel'].includes(b.voice)))return [{json:{valid:false}}];return [{json:{valid:true,voice:b.voice==='Adam'?'pNInz6obpgDQGcFmaJgB':'21m00Tcm4TlvDq8ikWAM',payload:{text:b.text,model_id:'eleven_multilingual_v2'}}}];"
      }
